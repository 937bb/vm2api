FROM vm2api-local:v1.3.153-hotfix-v37-codex-snapshot-cache
LABEL org.opencontainers.image.version="1.3.153-hotfix-v38-global-lease-retirement"

COPY package.json package-lock.json /opt/vm2api/
RUN cd /opt/vm2api && npm ci --omit=dev

COPY src/lib/pool/openai-global-lease.mjs /opt/vm2api/src/lib/pool/openai-global-lease.mjs
COPY src/lib/pool/openai-account-runtime.mjs /opt/vm2api/src/lib/pool/openai-account-runtime.mjs
COPY src/lib/protocol/handle-codex.mjs /opt/vm2api/src/lib/protocol/handle-codex.mjs
COPY src/lib/admin/panel-routes.mjs /opt/vm2api/src/lib/admin/panel-routes.mjs
COPY src/server.mjs /opt/vm2api/src/server.mjs

RUN printf '%s\n' '1.3.153-hotfix-v38-global-lease-retirement' > /opt/vm2api/VERSION
ENV VM2API_BUILD=1.3.153-hotfix-v38-global-lease-retirement
